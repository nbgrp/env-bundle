parameters:
  level: 9
  paths:
    - src
    - tests
  bootstrapFiles:
    - vendor/bin/.phpunit/phpunit/vendor/autoload.php

  ignoreErrors:
    -
      message: '/Cannot cast mixed to (int|float|string)/'
      path: 'src/ArrayCastEnvVarProcessor.php'
    -
      identifier: missingType.iterableValue
    -
      identifier: phpDoc.parseError
